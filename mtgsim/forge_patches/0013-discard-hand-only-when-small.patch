 public class DiscardAi extends SpellAbilityAi {
 
+    /**
+     * "Discard your hand, then draw N" (Stoke Genius, Dangerous Wager...): worth it only when the AI throws away
+     * fewer nonland cards than it draws. Lands count as well once the AI has the lands it needs for its hand.
+     */
+    private static boolean wheelIsWorthIt(Player ai, SpellAbility sa) {
+        final Card source = sa.getHostCard();
+        int drawn = 0;
+        for (SpellAbility s = sa.getSubAbility(); s != null; s = s.getSubAbility()) {
+            if (s.getApi() == ApiType.Draw && s.hasParam("NumCards")) {
+                drawn += AbilityUtils.calculateAmount(source, s.getParam("NumCards"), s);
+            }
+        }
+        if (drawn <= 0) {
+            return true; // not a wheel for cards: leave it to the rest of the logic
+        }
+        int lost = 0;
+        for (Card c : ai.getCardsIn(ZoneType.Hand)) {
+            if (c.equals(source) || c.getName().equals(source.getName())) {
+                continue;
+            }
+            if (!c.isLand() || ai.getLandsInPlay().size() >= 5) {
+                lost++;
+            }
+        }
+        return lost < drawn;
+    }
+
