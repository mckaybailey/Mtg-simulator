+++ b/forge-ai/src/main/java/forge/ai/ComputerUtil.java
@@ -314,6 +314,18 @@ public class ComputerUtil {
         return false;
     }
 
+    /** True if every step of the ability only looks at, reorders or mills the library (Scry, Surveil, ...). */
+    private static boolean onlyLooksAtLibrary(SpellAbility sa) {
+        for (SpellAbility s = sa.getRootAbility(); s != null; s = s.getSubAbility()) {
+            final ApiType api = s.getApi();
+            if (api != ApiType.Scry && api != ApiType.Surveil && api != ApiType.Mill
+                    && api != ApiType.RearrangeTopOfLibrary) {
+                return false;
+            }
+        }
+        return true;
+    }
+
     public static Card getCardPreference(final Player ai, final Card activate, final String pref, final CardCollection typeList) {
         return getCardPreference(ai, activate, pref, typeList, null);
     }
