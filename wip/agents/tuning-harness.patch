+  },
+  {
+   "key": "ATTACK_INTO_TRADE_WHEN_TAPPED_OUT",
+   "values": [true],
+   "why": "Default only attacks into trades while holding mana for a trick; Reckless also does when tapped out."
+  },
+  {
+   "key": "TRY_TO_AVOID_ATTACKING_INTO_CERTAIN_BLOCK",
+   "values": [false],
+   "why": "Extra checks that stop attacks which cannot deal damage (Cautious and Reckless turn them off)."
+  },
+  {
+   "name": "hold-tricks",
+   "keys": ["TRY_TO_HOLD_COMBAT_TRICKS_UNTIL_BLOCK", "CHANCE_TO_HOLD_COMBAT_TRICKS_UNTIL_BLOCK"],
+   "values": [[false, 65], [true, 100]],
+   "why": "Casting pump spells after blocks rather than before; mostly affects creature decks."
+  },
+  {
+   "key": "RESERVE_MANA_FOR_MAIN2_CHANCE",
+   "values": [0, 50],
+   "why": "Chance to keep mana sources for a spell predicted for the second main phase (ComputerUtilMana). The closest heuristic-AI knob to not tapping out early."
+  },
+  {
+   "key": "FLASH_CHANCE_TO_RESPOND_TO_STACK_WITH_ETB",
+   "values": [30, 60],
+   "groups": ["reactive"],
+   "why": "Default never casts a flash creature in response to a spell; the Azorius and Dimir lists play flash threats."
+  },
+  {
+   "name": "kill-evasive",
+   "keys": ["ACTIVELY_DESTROY_IMMEDIATELY_UNBLOCKABLE", "DESTROY_IMMEDIATELY_UNBLOCKABLE_ONLY_IN_DNGR"],
+   "values": [[true, false], [false, true]],
