+  {
+   "name": "counter-tricks",
+   "keys": ["ALWAYS_COUNTER_PUMP_SPELLS", "ALWAYS_COUNTER_AURAS", "ALWAYS_COUNTER_DAMAGE_SPELLS"],
+   "values": [[false, false, true], [false, false, false]],
+   "groups": ["reactive"],
+   "why": "Default spends counters on any pump spell, aura or burn spell regardless of the thresholds above; keeping them for threats is what human control players do."
+  },
+  {
+   "name": "danger-threshold",
+   "keys": ["AI_IN_DANGER_THRESHOLD", "AI_IN_DANGER_MAX_THRESHOLD"],
