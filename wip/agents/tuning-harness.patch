+  },
+  {
+   "name": "protect-planeswalkers",
+   "keys": ["CHANCE_TO_TRADE_TO_SAVE_PLANESWALKER", "CHUMP_TO_SAVE_PLANESWALKER_ONLY_ON_LETHAL"],
+   "values": [[100, false]],
+   "groups": ["reactive"],
+   "why": "Several reactive lists win with planeswalkers; Default only chump-blocks for one when the attack would kill it."
+  },
+  {
+   "key": "SACRIFICE_DEFAULT_PREF_ENABLE",
+   "values": [true],
+   "groups": ["reactive"],
+   "why": "Lets the AI pay sacrifice costs with cheap creatures and tokens when a card has no sacrifice preference of its own (Jund Sacrifice; Reckless enables it)."
+  },
+  {
+   "key": "MULLIGAN_THRESHOLD",
+   "values": [5, 6],
+   "why": "Hand size below which the AI stops mulliganing (Default 4). Slow decks suffer more from going to four or five."
+  },
+  {
+   "key": "FLAT_MC_MULLIGAN",
+   "values": [false],
+   "why": "Despite the name this acts with Monte Carlo off: the deck-plan mulligan (simulation.OpeningHand) instead of the old land-count rule. On by default (the AiProps default; Default.ai does not set it)."
+  },
+  {
+   "key": "FLAT_MC_DECK_PLAN",
+   "values": ["control", "midrange"],
+   "groups": ["reactive"],
+   "why": "The archetype the deck-plan mulligan judges hands by; 'auto' (default) reads it from the list and may call a value deck aggro."
+  },
+  {
+   "key": "FLAT_MC_DECK_PLAN",
+   "values": ["aggro"],
+   "groups": ["proactive"],
+   "why": "As above, for the creature decks."
+  }
+ ]
+}
