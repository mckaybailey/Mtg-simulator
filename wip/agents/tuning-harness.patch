+ "change_probability": 0.2,
+ "params": [
+  {
+   "name": "counter-chances",
+   "keys": ["CHANCE_TO_COUNTER_CMC_1", "CHANCE_TO_COUNTER_CMC_2", "CHANCE_TO_COUNTER_CMC_3"],
+   "values": [[0, 50, 100], [60, 90, 100], [100, 100, 100]],
+   "groups": ["reactive"],
+   "why": "Default counters a 1-drop 30% and a 2-drop 75% of the time (CounterAi). Saving counters for bigger threats (Cautious: 0/50/100) or countering everything changes how long a counterspell deck survives a curve of cheap creatures."
+  },
+  {
+   "key": "MIN_SPELL_CMC_TO_COUNTER",
+   "values": [1, 2, 3],
+   "groups": ["reactive"],
